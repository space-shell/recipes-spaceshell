---
interface Props {
  subs: string[];
}

const { subs } = Astro.props;
---

<section class="border-t-2 border-ink pt-8">
  <h2 class="font-serif text-3xl mb-4 tracking-tight">
    Swedish Cheese Substitutions
  </h2>
  <ul class="flex flex-col gap-3">
    {subs.map((sub) => (
      <li class="flex gap-3 border-l-2 border-ochre pl-4 text-sm font-light leading-relaxed text-ink-soft">
        {sub}
      </li>
    ))}
  </ul>
</section>
