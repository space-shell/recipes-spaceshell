---
const wordmark = "recipes";
const domain = "spaceshell.xyz";
---

<header
  class="border-b-2 border-ink"
>
  <div
    class="mx-auto max-w-6xl px-6 py-5 flex items-baseline justify-between gap-4"
  >
    <a href="/" class="group flex items-baseline gap-2">
      <span
        class="font-serif text-3xl leading-none tracking-tight text-ink group-hover:text-paprika transition-colors duration-100"
        >{wordmark}</span
      >
      <span class="text-sm font-light text-clay tracking-wide"
        >.{domain}</span
      >
    </a>
    <nav class="flex items-center gap-6 text-sm font-light text-ink-soft">
      <a href="/" class="hover:text-paprika transition-colors duration-100"
        >All</a
      >
    </nav>
  </div>
</header>
