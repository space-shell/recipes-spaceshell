---
interface Props {
  groups: Array<{
    group?: string;
    items: string[];
  }>;
}

const { groups } = Astro.props;
---

<div class="flex flex-col gap-px bg-ink border-2 border-ink">
  {
    groups.map((g) => (
      <section class="bg-paper-shade p-6 flex flex-col gap-4">
        {g.group && (
          <h3 class="font-serif text-2xl leading-none tracking-tight text-paprika">
            {g.group}
          </h3>
        )}
        <ul class="flex flex-col divide-y divide-ink/15">
          {g.items.map((item) => (
            <li class="flex items-baseline gap-3 py-2 text-sm font-light leading-relaxed">
              <span
                aria-hidden="true"
                class="text-paprika select-none"
              >
                ▸
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
