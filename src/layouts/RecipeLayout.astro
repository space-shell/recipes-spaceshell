---
import BaseLayout from "./BaseLayout.astro";
import IngredientList from "../components/IngredientList.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { recipe } = Astro.props;
const { data } = recipe;

const dateLabel = data.date.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${data.title} · recipes.spaceshell.xyz`} description={data.description}>
  <article class="mx-auto max-w-6xl px-6 py-block">
    <!-- Hero / masthead -->
    <header class="border-b-2 border-ink pb-8 mb-8">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-xs font-light uppercase tracking-widest text-clay mb-6">
        {data.method && <span>{data.method}</span>}
        {data.cuisine && <span class="text-paprika">· {data.cuisine}</span>}
        <span>· {dateLabel}</span>
      </div>
      <h1 class="font-serif text-6xl md:text-8xl leading-[0.9] tracking-tight text-ink">
        {data.title}
      </h1>
      {
        data.description && (
          <p class="mt-6 max-w-2xl text-lg font-light leading-relaxed text-ink-soft">
            {data.description}
          </p>
        )
      }
    </header>

    <!-- Stat row: brutalist ratio blocks -->
    <dl class="grid grid-cols-2 md:grid-cols-4 border-2 border-ink mb-block">
      {
        data.servings && (
          <div class="border-b-2 md:border-b-0 md:border-r-2 border-ink p-5 flex flex-col gap-1">
            <dt class="text-[10px] font-light uppercase tracking-widest text-clay">
              Servings
            </dt>
            <dd class="font-serif text-3xl leading-none">{data.servings}</dd>
          </div>
        )
      }
      {
        data.prepTime && (
          <div class="border-b-2 md:border-b-0 md:border-r-2 border-ink p-5 flex flex-col gap-1">
            <dt class="text-[10px] font-light uppercase tracking-widest text-clay">
              Prep
            </dt>
            <dd class="font-serif text-3xl leading-none">{data.prepTime}</dd>
          </div>
        )
      }
      {
        data.cookTime && (
          <div class="border-r-2 border-ink p-5 flex flex-col gap-1">
            <dt class="text-[10px] font-light uppercase tracking-widest text-clay">
              Cook
            </dt>
            <dd class="font-serif text-3xl leading-none">{data.cookTime}</dd>
          </div>
        )
      }
      <div class="p-5 flex flex-col gap-1">
        <dt class="text-[10px] font-light uppercase tracking-widest text-clay">
          Tags
        </dt>
        <dd class="text-sm font-light leading-snug text-ink-soft">
          {data.tags.join(" · ")}
        </dd>
      </div>
    </dl>

    <!-- Two-column body: ingredients (sticky rail) + method -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-8">
      <aside class="lg:sticky lg:top-6 lg:self-start">
        <h2 class="font-serif text-3xl mb-4 tracking-tight">Ingredients</h2>
        <IngredientList groups={data.ingredients} />
      </aside>

      <div class="max-w-none">
        <h2 class="font-serif text-3xl mb-4 tracking-tight">Method</h2>
        <div
          class="prose-recipe text-ink font-light leading-relaxed
                 [&_h2]:font-serif [&_h2]:text-3xl [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:tracking-tight
                 [&_h3]:font-serif [&_h3]:text-2xl [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-paprika [&_h3]:tracking-tight
                 [&_p]:text-base [&_p]:leading-relaxed [&_p]:text-ink-soft
                 [&_strong]:font-normal [&_strong]:text-ink
                 [&_li]:text-base [&_li]:text-ink-soft"
        >
          <slot />
        </div>

        {
          data.notes && data.notes.length > 0 && (
            <section class="mt-block border-t-2 border-ink pt-8">
              <h2 class="font-serif text-3xl mb-4 tracking-tight">Notes</h2>
              <ul class="flex flex-col gap-3">
                {data.notes.map((note) => (
                  <li class="flex gap-3 border-l-2 border-paprika pl-4 text-sm font-light leading-relaxed text-ink-soft">
                    {note}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
