---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";

const recipes = (await getCollection("recipes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const count = recipes.length;
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-6 py-block">
    <!-- Masthead: oversized serif headline + count -->
    <header class="border-b-2 border-ink pb-8 mb-8">
      <p
        class="text-xs font-light uppercase tracking-widest text-clay mb-4"
      >
        A personal cookbook
      </p>
      <h1
        class="font-serif text-7xl md:text-9xl leading-[0.85] tracking-tight text-ink"
      >
        recipes<span class="text-paprika">.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base font-light leading-relaxed text-ink-soft">
        Hand-written, cooked-many-times, keep-forever recipes.
        Currently {count} {count === 1 ? "entry" : "entries"} on file.
      </p>
    </header>

    <!-- Recipe grid -->
    {
      recipes.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recipes.map((recipe) => (
            <RecipeCard recipe={recipe} />
          ))}
        </div>
      ) : (
        <p class="font-serif text-2xl text-ink-soft">
          No recipes yet — drop a Markdown file in{" "}
          <code class="text-paprika">src/content/recipes/</code>.
        </p>
      )
    }
  </section>
</BaseLayout>
